<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Novil Trading</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#080d18;color:#f4f7ff;font-family:Arial,sans-serif}
header{padding:22px 16px;background:#111a2b;border-bottom:1px solid #26334a}
h1{margin:0;color:#54e0b3;font-size:25px}
header p{color:#9eabc2;margin-bottom:0}
main{padding:16px;max-width:900px;margin:auto}
h2{font-size:19px;margin-top:24px}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.card{background:#111a2b;padding:16px;border:1px solid #26334a;border-radius:12px}
.label{color:#9eabc2;font-size:13px}
.price{font-size:20px;font-weight:bold;margin-top:10px}
.green{color:#54e0b3}
.red{color:#ff7185}
button{background:#54e0b3;color:#08120f;border:0;padding:12px 16px;border-radius:8px;font-weight:bold}
.note{color:#9eabc2;font-size:13px;line-height:1.6}
footer{text-align:center;padding:24px;color:#9eabc2}
@media(min-width:600px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
</style>
</head>
<body>
<header>
<h1>NOVIL TRADING</h1>
<p>Forex • Crypto • Market Dashboard</p>
</header>
<main>
<h2>📊 Market Watch</h2>
<div class="grid">
<div class="card">
<div class="label">BITCOIN / USD</div>
<div class="price" id="btc">Loading...</div>
<div class="label">BTC / USDT</div>
</div>
<div class="card">
<div class="label">ETHEREUM / USD</div>
<div class="price" id="eth">Loading...</div>
<div class="label">ETH / USDT</div>
</div>
<div class="card">
<div class="label">SOLANA / USD</div>
<div class="price" id="sol">Loading...</div>
<div class="label">SOL / USDT</div>
</div>
</div>

<h2>📈 Live Crypto Chart</h2>
<div class="card">
<div class="tradingview-widget-container">
<div id="tradingview_chart"></div>
</div>
</div>

<h2>💱 Forex Chart</h2>
<div class="card">
<p>EUR / USD</p>
<div id="forex_chart"></div>
</div>

<h2>🧠 Trading Tools</h2>
<div class="grid">
<div class="card">
<h3>Risk Calculator</h3>
<p class="note">Plan your risk before entering a trade.</p>
<label class="label">Account balance ($)</label>
<input id="balance" type="number" value="1000" style="width:100%;padding:10px;margin:8px 0">
<label class="label">Risk (%)</label>
<input id="risk" type="number" value="1" min="0" max="100" step="0.1" style="width:100%;padding:10px;margin:8px 0">
<button onclick="calculateRisk()">Calculate</button>
<p id="result" class="green"></p>
</div>
<div class="card">
<h3>Trading Reminder</h3>
<p class="note">Wait for confirmation. Always plan your stop-loss. Avoid emotional trades.</p>
</div>
</div>
<p class="note">Market prices can change quickly. This dashboard is for learning and information only, not financial advice.</p>
</main>
<footer>© 2026 Novil Trading</footer>

<script>
async function loadPrices(){
try{
const response=await fetch('https://api.binance.com/api/v3/ticker/price?symbols=%5B%22BTCUSDT%22,%22ETHUSDT%22,%22SOLUSDT%22%5D');
const data=await response.json();
data.forEach(item=>{
const id={BTCUSDT:'btc',ETHUSDT:'eth',SOLUSDT:'sol'}[item.symbol];
if(id)document.getElementById(id).textContent='$'+Number(item.price).toLocaleString('en-US',{maximumFractionDigits:2});
});
}catch(error){
['btc','eth','sol'].forEach(id=>document.getElementById(id).textContent='Price unavailable');
}
}
function calculateRisk(){
const balance=Number(document.getElementById('balance').value);
const risk=Number(document.getElementById('risk').value);
const result=document.getElementById('result');
if(balance<=0||risk<=0||risk>100){result.textContent='Enter valid balance and risk.';return;}
result.textContent='Maximum planned risk: $'+(balance*risk/100).toFixed(2);
}
loadPrices();
setInterval(loadPrices,15000);
</script>
<script src="https://s3.tradingview.com/tv.js"></script>
<script>
function createChart(container,symbol){
new TradingView.widget({
width:"100%",height:400,symbol:symbol,interval:"60",
timezone:"Asia/Kolkata",theme:"dark",style:"1",
locale:"en",enable_publishing:false,
allow_symbol_change:true,container_id:container
});
}
</script>
<script>
window.addEventListener('load',()=>{
if(window.TradingView){
createChart('tradingview_chart','BINANCE:BTCUSDT');
createChart('forex_chart','FX:EURUSD');
}
});
</script>
</body>
</html>
